{
  // Office Share cloud relay. Deploy with the "Deploy to Cloudflare" button in the README,
  // or locally: npx wrangler deploy
  "name": "office-share-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "office-share-relay" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "office-share-relay" }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
